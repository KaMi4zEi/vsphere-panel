# =============================================================
#  vSphere Panel — .env
#  Copiez ce fichier en .env et remplissez les valeurs
#  DATABASE_URL est construit automatiquement — ne pas modifier
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
# Seul ce mot de passe est à définir — DATABASE_URL se construit tout seul
# Utiliser des caractères alphanumériques ; cette valeur est injectée dans une URL PostgreSQL.
POSTGRES_PASSWORD=votre_mot_de_passe_fort

# ── NextAuth ──────────────────────────────────────────────────
# Générer : openssl rand -base64 32
NEXTAUTH_SECRET=CHANGEZ_MOI
SETTINGS_ENCRYPTION_KEY=CHANGEZ_MOI_AVEC_UNE_CLE_DISTINCTE
NEXTAUTH_URL=http://localhost:3000

# ── Docker (optionnel) ────────────────────────────────────────
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
